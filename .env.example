# Copy to .env for local development. Do not use sample credentials elsewhere.
DATABASE_URL=postgresql+psycopg://scheduler:local-development-only@localhost:5432/scheduler

# Used by Docker Compose; keep these in sync with DATABASE_URL.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST_PORT=5432

# Independent consumer process settings.
CONSUMER_ID=
WORKER_CONCURRENCY=4
POLL_INTERVAL_SECONDS=0.5
CLAIM_BATCH_SIZE=10
LEASE_SECONDS=30
SHUTDOWN_GRACE_SECONDS=20
DB_RECONNECT_BASE_SECONDS=0.5
DB_RECONNECT_MAX_SECONDS=15
